<launch>
    <arg name="robot_id" default="$(env ROBOT_ID)"/>

    <group ns="robot$(arg robot_id)">
        <node pkg="drive_controller" type="drive_controller" name="drive_controller" output="screen">
            <param name="odom_pub_topic" value="odom_legacy"/>
            <param name="odom_sub_topic" value="arduino_odom"/>
            <param name="cmd_vel_sub_topic" value="cmd_vel_legacy"/>
            <param name="cmd_vel_pub_topic" value="velocities"/>
            <param name="reset_sub_topic" value="reset_legacy"/>
            <param name="r" value="0.048"/>
            <param name="lx" value="0.097"/>
            <param name="ly" value="0.107"/>
            <param name="ticks" value="206.26"/>
            <param name="frame_id" value="odom"/>
            <param name="child_frame_id" value="base_footprint"/>
            <param name="reset_timeout" value="1"/>
        </node>
    </group>
</launch>
